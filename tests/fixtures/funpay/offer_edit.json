{"html": "<form class=\"form-offer-editor\" method=\"post\" action=\"https://funpay.com/lots/offerSave\">\n  <input type=\"hidden\" name=\"csrf_token\" value=\"csrf-token-test-123\">\n  <input type=\"hidden\" name=\"offer_id\" value=\"0\">\n  <input type=\"hidden\" name=\"node_id\" value=\"148\">\n  <input type=\"hidden\" name=\"location\" value=\"trade\">\n  <div class=\"form-group\">\n    <label class=\"control-label\">Сервер</label>\n    <select class=\"form-control\" name=\"fields[server]\">\n      <option value=\"\">Выберите сервер</option>\n      <option value=\"101\">RU</option>\n      <option value=\"102\">EU</option>\n      <option value=\"103\">NA</option>\n    </select>\n  </div>\n  <div class=\"form-group\">\n    <label class=\"control-label\">Тип аккаунта</label>\n    <select class=\"form-control\" name=\"fields[type]\">\n      <option value=\"1\" selected>Обычный</option>\n      <option value=\"2\">Премиум</option>\n    </select>\n  </div>\n  <div class=\"form-group\">\n    <label class=\"control-label\">Краткое описание (RU)</label>\n    <input type=\"text\" class=\"form-control\" name=\"fields[summary][ru]\" value=\"\" maxlength=\"120\">\n  </div>\n  <div class=\"form-group\">\n    <label class=\"control-label\">Краткое описание (EN)</label>\n    <input type=\"text\" class=\"form-control\" name=\"fields[summary][en]\" value=\"\" maxlength=\"120\">\n  </div>\n  <div class=\"form-group\">\n    <label class=\"control-label\">Подробное описание (RU)</label>\n    <textarea class=\"form-control\" name=\"fields[desc][ru]\" rows=\"6\"></textarea>\n  </div>\n  <div class=\"form-group\">\n    <label class=\"control-label\">Подробное описание (EN)</label>\n    <textarea class=\"form-control\" name=\"fields[desc][en]\" rows=\"6\"></textarea>\n  </div>\n  <div class=\"form-group\">\n    <input type=\"text\" class=\"form-control\" name=\"fields[payment_msg][ru]\" placeholder=\"Сообщение покупателю после оплаты\" value=\"\">\n  </div>\n  <div class=\"form-group\">\n    <label class=\"control-label\">Цена, ₽</label>\n    <input type=\"number\" class=\"form-control\" name=\"price\" value=\"\" step=\"0.01\" required>\n  </div>\n  <div class=\"form-group\">\n    <label class=\"control-label\">Количество</label>\n    <input type=\"number\" class=\"form-control\" name=\"amount\" value=\"1\">\n  </div>\n  <div class=\"form-group\">\n    <div class=\"checkbox\"><label><input type=\"checkbox\" name=\"active\" checked> Активно</label></div>\n  </div>\n  <div class=\"form-group\">\n    <div class=\"checkbox\"><label><input type=\"checkbox\" name=\"deactivate_after_sale\"> Деактивировать после продажи</label></div>\n  </div>\n  <div class=\"form-group\">\n    <div class=\"checkbox\"><label><input type=\"checkbox\" name=\"fields[auto_delivery]\" value=\"1\"> Автовыдача</label></div>\n  </div>\n  <button type=\"submit\" class=\"btn btn-primary\" name=\"submit\">Сохранить</button>\n</form>\n", "url": "https://funpay.com/lots/offerEdit?node=148"}